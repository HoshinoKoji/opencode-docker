{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "serious",
  "permission": {
    "read": {
      ".casual/**": "deny"
    },
    "edit": {
      "*": "ask",
      "AGENTS.md": "allow",
      "MEMORY.md": "allow",
      ".sessions/**": "allow",
      ".casual/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git diff": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git worktree list": "allow"
    },
    "question": "allow"
  }
}

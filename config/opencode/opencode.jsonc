{
  "$schema": "https://opencode.ai/config.json",
  // Neutral development defaults shared by every project that uses the runtime.
  // This file must not select a chat agent or restrict tools; chat behavior
  // lives in config/chat/ and is loaded only by the personal chat workspace.
  "autoupdate": false,
  "skills": {
    "paths": ["/opt/claude-skills"]
  }
}

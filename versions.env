# Single source of truth for the tool versions baked into the OpenCode runtime
# image. Both local builds (start.sh sources this file) and the publish workflow
# read these values, so a release never depends on an implicit `latest`.
#
# Each line only assigns a default: an explicit value in the environment wins,
# so development overrides work, for example:
#   BUN_VERSION=1.3.15 ./start.sh --build
#
# Other tool pins verified against upstream release sources on 2026-10-07.
# uv verified against its official release source on 2026-10-24.
# OpenCode v2 verified against its official release source on 2026-11-02.
: "${BUN_VERSION:=1.3.14}"
: "${NODE_VERSION:=24.15.0}"
: "${UV_VERSION:=0.13.5}"
: "${OPENCODE_VERSION:=2.2.5}"
: "${RUST_VERSION:=1.99.0}"
